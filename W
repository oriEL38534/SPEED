local peakSpeed = 0

resetPeakBtn.MouseButton1Click:Connect(function()
	peakSpeed = 0
	peakSpeedLabel.Text = "🔥 Peak Speed: 0"
end)

local function getBall()
	local ballsFolder = Workspace:FindFirstChild("Balls")
	if ballsFolder then
		for _, v in pairs(ballsFolder:GetChildren()) do
			if v:getAttribute("realBall") == true or v:FindFirstChild("zoomies") or v.Name == "Ball" then
				return v
			end
		end
	end
	return Workspace:FindFirstChild("Ball")
end

RunService.RenderStepped:Connect(function()
	if ballStatsActive and statsFrame.Visible then
		local ball = getBall()
		if ball and ball:IsA("BasePart") then
			local currentSpeed = math.floor(ball.AssemblyLinearVelocity.Magnitude)
			
			if currentSpeed > peakSpeed then
				peakSpeed = currentSpeed
				peakSpeedLabel.Text = "🔥 Peak Speed: " .. tostring(peakSpeed)
			end
			
			currentSpeedLabel.Text = "⚡ Speed: " .. tostring(currentSpeed)
		else
			currentSpeedLabel.Text = "⚡ Speed: 0"
		end
	end
end)

