-- Infinite Jump
local infJumpBtn = createButton("♾️ Infinite Jump: כבוי", 135, function() end)

local ACTION_NAME = "InfJumpAction"

local function handleJumpAction(actionName, inputState, inputObject)
	if inputState == Enum.UserInputState.Begin and infJumpActive then
		local char = player.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
		end
	end
	return Enum.ContextAnimationFrame.Pass
end

local function disableInfJump()
	infJumpActive = false
	ContextActionService:UnbindAction(ACTION_NAME)
	infJumpBtn.Text = "♾️ Infinite Jump: כבוי"
	infJumpBtn.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
end

local function enableInfJump()
	disableInfJump()
	infJumpActive = true
	ContextActionService:BindAction(ACTION_NAME, handleJumpAction, false, Enum.KeyCode.Space)
	infJumpBtn.Text = "✅ Infinite Jump: פעיל"
	infJumpBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
end

infJumpBtn.MouseButton1Click:Connect(function()
	if infJumpActive then disableInfJump() else enableInfJump() end
end)

-- קוסמטיקה
local function applyKorblox()
	pcall(function()
		local char = player.Character
		if not char then return end
		local rightLegR6 = char:FindFirstChild("Right Leg")
		if rightLegR6 then
			local mesh = char:FindFirstChildOfClass("CharacterMesh")
			if not mesh or mesh.BodyPart ~= Enum.BodyPart.RightLeg then
				mesh = Instance.new("CharacterMesh")
				mesh.BodyPart = Enum.BodyPart.RightLeg
				mesh.Parent = char
			end
			mesh.MeshId = 90294209
			rightLegR6.Transparency = 0
		else
			local rightLower = char:FindFirstChild("RightLowerLeg")
			local rightFoot = char:FindFirstChild("RightFoot")
			if rightLower then
				local mesh = rightLower:FindFirstChildOfClass("SpecialMesh") or Instance.new("SpecialMesh", rightLower)
				mesh.MeshId = "rbxassetid://90294209"
				mesh.TextureId = "rbxassetid://90284029"
			end
			if rightFoot then rightFoot.Transparency = 1 end
		end
	end)
end

local function applyHeadless()
	pcall(function()
		local char = player.Character
		if not char then return end
		local head = char:FindFirstChild("Head")
		if head then
			head.Transparency = 1
			local face = head:FindFirstChildOfClass("Decal")
			if face then face.Transparency = 1 end
		end
	end)
end

