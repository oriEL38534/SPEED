local function getBall()
	local bestBall = nil
	local highestVelocity = 0

	for _, v in pairs(Workspace:GetChildren()) do
		if v:IsA("BasePart") and v.AssemblyLinearVelocity.Magnitude > 10 then
			if v.AssemblyLinearVelocity.Magnitude > highestVelocity then
				highestVelocity = v.AssemblyLinearVelocity.Magnitude
				bestBall = v
			end
		end
	end
	
	local ballsFolder = Workspace:FindFirstChild("Balls") or Workspace:FindFirstChild("BallFolder")
	if ballsFolder then
		for _, v in pairs(ballsFolder:GetChildren()) do
			if v:IsA("BasePart") then
				if v.AssemblyLinearVelocity.Magnitude > highestVelocity then
					highestVelocity = v.AssemblyLinearVelocity.Magnitude
					bestBall = v
				end
			end
		end
	end
	
	return bestBall
end

RunService.RenderStepped:Connect(function()
	if ballStatsActive and statsFrame.Visible then
		local ball = getBall()
		if ball then
			local currentSpeed = math.floor(ball.AssemblyLinearVelocity.Magnitude)
			
			if currentSpeed > peakSpeed then
				peakSpeed = currentSpeed
				peakSpeedLabel.Text = "🔥 Peak Speed: " .. tostring(peakSpeed)
			end
			
			currentSpeedLabel.Text = "⚡ Speed: " .. tostring(currentSpeed)
		else
			currentSpeedLabel.Text = "⚡ Speed: Searching..."
		end
	end
end)

