local ACTION_NAME = "InfJumpAction"

local function handleJumpAction(actionName, inputState, inputObject)
	if inputState == Enum.UserInputState.Begin and infJumpActive then
		local char = player.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
		end
	end
	return Enum.ContextAnimationFrame.Pass
end

local function disableInfJump()
	infJumpActive = false
	ContextActionService:UnbindAction(ACTION_NAME)
	infJumpBtn.Text = "♾️ Inf Jump: כבוי"
	infJumpBtn.BackgroundColor3 = Color3.fromRGB(35, 30, 48)
end

local function enableInfJump()
	disableInfJump()
	infJumpActive = true
	ContextActionService:BindAction(ACTION_NAME, handleJumpAction, false, Enum.KeyCode.Space)
	infJumpBtn.Text = "✅ Inf Jump: פעיל"
	infJumpBtn.BackgroundColor3 = Color3.fromRGB(140, 50, 200)
end

infJumpBtn.MouseButton1Click:Connect(function()
	if infJumpActive then disableInfJump() else enableInfJump() end
end)

