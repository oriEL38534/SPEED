local function removeHighlights()
	if highlightsFolder then highlightsFolder:Destroy() highlightsFolder = nil end
	if createdLight then createdLight:Destroy() createdLight = nil end
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Highlight") and (obj.Name == "BallSuperGlow" or obj.Name:find("_Glow") or obj.Name:find("_BlackAura")) then
			obj:Destroy()
		end
		if obj:IsA("PointLight") and obj.Name == "BallLight" then obj:Destroy() end
	end
end

local function applyDarkHighlights()
	removeHighlights()
	highlightsFolder = Instance.new("Folder")
	highlightsFolder.Name = "GlowHighlights"
	highlightsFolder.Parent = Workspace

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			local plrHighlight = Instance.new("Highlight")
			plrHighlight.Name = plr.Name .. "_Glow"
			plrHighlight.FillColor = Color3.fromRGB(0, 180, 255)
			plrHighlight.FillTransparency = 0.5
			plrHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			plrHighlight.OutlineTransparency = 0
			plrHighlight.Parent = highlightsFolder
			plrHighlight.Adornee = plr.Character
		end
	end
end

local function applyBlackAura()
	removeHighlights()
	highlightsFolder = Instance.new("Folder")
	highlightsFolder.Name = "BlackAuraHighlights"
	highlightsFolder.Parent = Workspace

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			local blackHighlight = Instance.new("Highlight")
			blackHighlight.Name = plr.Name .. "_BlackAura"
			blackHighlight.FillColor = Color3.fromRGB(0, 0, 0)
			blackHighlight.FillTransparency = 0.05
			blackHighlight.OutlineColor = Color3.fromRGB(0, 0, 0)
			blackHighlight.OutlineTransparency = 0
			blackHighlight.Parent = highlightsFolder
			blackHighlight.Adornee = plr.Character
		end
	end
end

