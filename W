-- פונקציה לעדכון מהירות
local function setSpeed(newSpeed)
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = newSpeed
	end
end

-- מערך לרשימת כפתורים לעדכון עיצוב דינמי
local allButtons = {}

local function createButton(text, positionY, onClick)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.86, 0, 0, 32)
	btn.Position = UDim2.new(0.07, 0, 0, positionY)
	btn.Text = text
	btn.BorderSizePixel = 0
	btn.TextSize = 15
	btn.Font = Enum.Font.SourceSansSemibold
	btn.Parent = frame

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 5)
	btnCorner.Parent = btn

	btn.MouseButton1Click:Connect(function()
		onClick(btn)
	end)
	
	table.insert(allButtons, btn)
	return btn
end

-- כפתורי מהירות
createButton("מהירות 30", 45, function() setSpeed(30) end)
createButton("מהירות 100", 85, function() setSpeed(100) end)
createButton("מהירות 200", 125, function() setSpeed(200) end)
createButton("איפוס מהירות (16)", 165, function() setSpeed(16) end)

-- כפתור Infinite Jump
local infJumpBtn = createButton("🦘 Infinite Jump: כבוי", 205, function() end)

-- כפתור החלפת ערכת נושא (Theme)
local themeBtn = createButton("🎨 עיצוב: כהה (Dark)", 250, function() end)

-- כפתור איפוס מלא
local resetAllBtn = createButton("🛑 איפוס הכל", 295, function() end)

-- פונקציה להחלת ערכת נושא
local function applyTheme(themeIndex)
	local theme = themes[themeIndex]
	
	frame.BackgroundColor3 = theme.FrameBg
	frame.BorderColor3 = theme.FrameBorder
	title.TextColor3 = theme.TitleColor
	closeBtn.TextColor3 = theme.TitleColor
	
	toggleBtn.BackgroundColor3 = theme.FrameBg
	toggleBtn.BorderColor3 = theme.FrameBorder
	toggleBtn.TextColor3 = theme.TitleColor
	
	themeBtn.Text = "🎨 " .. theme.Name

	for _, btn in ipairs(allButtons) do
		if btn == infJumpBtn and infJumpActive then
			btn.BackgroundColor3 = theme.ActiveBtnBg
		elseif btn == resetAllBtn then
			btn.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
			btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		else
			btn.BackgroundColor3 = theme.BtnBg
			btn.TextColor3 = theme.BtnText
		end
	end
end

themeBtn.MouseButton1Click:Connect(function()
	currentThemeIndex = currentThemeIndex + 1
	if currentThemeIndex > #themes then
		currentThemeIndex = 1
	end
	applyTheme(currentThemeIndex)
end)

-- לוגיקת Infinite Jump
local function disableInfJump()
	infJumpActive = false
	if infJumpConnection then
		infJumpConnection:Disconnect()
		infJumpConnection = nil
	end
	infJumpBtn.Text = "🦘 Infinite Jump: כבוי"
	applyTheme(currentThemeIndex)
end

local function enableInfJump()
	disableInfJump()
	infJumpActive = true
	infJumpBtn.Text = "✅ Infinite Jump: פעיל"
	applyTheme(currentThemeIndex)
	
	infJumpConnection = UserInputService.JumpRequest:Connect(function()
		if infJumpActive then
			local char = player.Character
			if char then
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum then
					hum:ChangeState(Enum.HumanoidStateType.Jumping)
				end
			end
		end
	end)
end

infJumpBtn.MouseButton1Click:Connect(function()
	if infJumpActive then disableInfJump() else enableInfJump() end
end)

-- איפוס מלא
resetAllBtn.MouseButton1Click:Connect(function()
	disableInfJump()
	setSpeed(16)
end)

-- החלת ערכת נושא התחלתית
applyTheme(1)
