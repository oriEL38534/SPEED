-- לוגיקת Infinite Jump
local function disableInfJump()
	infJumpActive = false
	if infJumpConnection then
		infJumpConnection:Disconnect()
		infJumpConnection = nil
	end
	infJumpBtn.Text = "🦘 Infinite Jump: כבוי"
	infJumpBtn.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
end

local function enableInfJump()
	disableInfJump()
	infJumpActive = true
	infJumpBtn.Text = "✅ Infinite Jump: פעיל"
	infJumpBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
	
	infJumpConnection = UserInputService.JumpRequest:Connect(function()
		if infJumpActive then
			local char = player.Character
			if char then
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum then
					hum:ChangeState(Enum.HumanoidStateType.Jumping)
				end
			end
		end
	end)
end

infJumpBtn.MouseButton1Click:Connect(function()
	if infJumpActive then disableInfJump() else enableInfJump() end
end)

