local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

-- משתנים לניהול Infinite Jump
local infiniteJumpEnabled = false
local jumpConnection = nil

-- ניקוי ממשק ישן אם קיים
local pGui = player:WaitForChild("PlayerGui")
if pGui:FindFirstChild("SpeedMenuGui") then
	pGui.SpeedMenuGui:Destroy()
end

-- יצירת הממשק הוויזואלי (ScreenGui)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "SpeedMenuGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = pGui

-- יצירת המסגרת (Frame) - לבן נקי
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 200, 0, 310)
frame.Position = UDim2.new(0.05, 0, 0.3, 0)
frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255) -- לבן מוחלט
frame.BorderSizePixel = 1
frame.BorderColor3 = Color3.fromRGB(220, 220, 220) -- מסגרת אפורה בהירה מאוד
frame.Active = true
frame.Draggable = true
frame.Parent = screenGui

-- כותרת - אפור בהיר ומופרד
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -30, 0, 40)
title.Position = UDim2.new(0, 0, 0, 0)
title.Text = "תפריט מהירות"
title.TextColor3 = Color3.fromRGB(0, 0, 0) -- טקסט שחור
title.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
title.BorderSizePixel = 0
title.TextSize = 18
title.Font = Enum.Font.SourceSansBold
title.Parent = frame

-- כפתור סגירה (X)
local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 30, 0, 40)
closeBtn.Position = UDim2.new(1, -30, 0, 0)
closeBtn.Text = "✕"
closeBtn.TextColor3 = Color3.fromRGB(120, 120, 120)
closeBtn.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
closeBtn.BorderSizePixel = 0
closeBtn.TextSize = 16
closeBtn.Font = Enum.Font.SourceSansBold
closeBtn.Parent = frame

-- כפתור צף להצגה/הסתרה (Toggle Button)
local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.new(0, 80, 0, 35)
toggleBtn.Position = UDim2.new(0.02, 0, 0.2, 0)
toggleBtn.Text = "⚡ תפריט"
toggleBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.BorderSizePixel = 1
toggleBtn.BorderColor3 = Color3.fromRGB(210, 210, 210)
toggleBtn.TextSize = 14
toggleBtn.Font = Enum.Font.SourceSansBold
toggleBtn.Active = true
toggleBtn.Draggable = true
toggleBtn.Parent = screenGui

-- לוגיקת פתיחה/סגירה
local function toggleMenu()
	frame.Visible = not frame.Visible
end

closeBtn.MouseButton1Click:Connect(toggleMenu)
toggleBtn.MouseButton1Click:Connect(toggleMenu)

-- פונקציה לעדכון המהירות
local function setSpeed(newSpeed)
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = newSpeed
		print("המהירות שונתה ל: " .. newSpeed)
	end
end

-- פונקציית עזר ליצירת כפתורים בהירים
local function createButton(text, positionY, onClick)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.8, 0, 0, 30)
	btn.Position = UDim2.new(0.1, 0, 0, positionY)
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(0, 0, 0) -- טקסט שחור
	btn.BackgroundColor3 = Color3.fromRGB(250, 250, 250) -- כפתור כמעט לבן
	btn.BorderSizePixel = 1
	btn.BorderColor3 = Color3.fromRGB(220, 220, 220)
	btn.TextSize = 15
	btn.Font = Enum.Font.SourceSans
	btn.Parent = frame

	btn.MouseButton1Click:Connect(function()
		onClick(btn)
	end)
	return btn
end

-- כפתורי מהירות
createButton("מהירות 30", 50, function() setSpeed(30) end)
createButton("מהירות 100", 90, function() setSpeed(100) end)
createButton("מהירות 200", 130, function() setSpeed(200) end)
createButton("איפוס מהירות (16)", 170, function() setSpeed(16) end)

-- מנגנון Infinite Jump
jumpConnection = UserInputService.JumpRequest:Connect(function()
	if infiniteJumpEnabled then
		local char = player.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
	end
end)

-- כפתורי Infinite Jump
local infJumpBtn = createButton("♾️ הפעל Inf Jump", 215, function(btn)
	infiniteJumpEnabled = true
	btn.Text = "✅ Inf Jump פעיל"
	btn.BackgroundColor3 = Color3.fromRGB(225, 245, 225) -- ירוק בהיר מאוד
end)

createButton("🔴 כבה Inf Jump", 255, function()
	infiniteJumpEnabled = false
	infJumpBtn.Text = "♾️ הפעל Inf Jump"
	infJumpBtn.BackgroundColor3 = Color3.fromRGB(250, 250, 250)
end)
