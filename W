-- לוגיקת פתיחה/סגירה
local function toggleMenu()
	frame.Visible = not frame.Visible
end

closeBtn.MouseButton1Click:Connect(toggleMenu)
toggleBtn.MouseButton1Click:Connect(toggleMenu)

-- פונקציה לעדכון המהירות
local function setSpeed(newSpeed)
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = newSpeed
		print("המהירות שונתה ל: " .. newSpeed)
	end
end

-- פונקציית עזר ליצירת כפתורים
local function createButton(text, positionY, onClick)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.8, 0, 0, 30)
	btn.Position = UDim2.new(0.1, 0, 0, positionY)
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(0, 0, 0)
	btn.BackgroundColor3 = Color3.fromRGB(250, 250, 250)
	btn.BorderSizePixel = 1
	btn.BorderColor3 = Color3.fromRGB(220, 220, 220)
	btn.TextSize = 15
	btn.Font = Enum.Font.SourceSans
	btn.Parent = frame

	btn.MouseButton1Click:Connect(function()
		onClick(btn)
	end)
	return btn
end

-- כפתורי מהירות
createButton("מהירות 30", 50, function() setSpeed(30) end)
createButton("מהירות 100", 90, function() setSpeed(100) end)
createButton("מהירות 200", 130, function() setSpeed(200) end)
createButton("איפוס מהירות (16)", 170, function() setSpeed(16) end)

-- מנגנון Infinite Jump
UserInputService.JumpRequest:Connect(function()
	if infiniteJumpEnabled then
		local char = player.Character
		if char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end
	end
end)

-- כפתורי Infinite Jump
local infJumpBtn = createButton("♾️ הפעל Inf Jump", 215, function(btn)
	infiniteJumpEnabled = true
	btn.Text = "✅ Inf Jump פעיל"
	btn.BackgroundColor3 = Color3.fromRGB(225, 245, 225)
end)

createButton("🔴 כבה Inf Jump", 255, function()
	infiniteJumpEnabled = false
	infJumpBtn.Text = "♾️ הפעל Inf Jump"
	infJumpBtn.BackgroundColor3 = Color3.fromRGB(250, 250, 250)
end)

-- מנגנון ספאם בלחיצה על המסך / עכבר
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and spamEnabled then
		isSpamming = true
		task.spawn(function()
			while isSpamming and spamEnabled do
				if mouse1click then
					mouse1click()
				end
				task.wait() -- הקצב הכי מהיר שהמנוע מאפשר
			end
		end)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isSpamming = false
	end
end)

-- כפתורי ספאם
local spamBtn = createButton("⚡ הפעל ספאם מסך", 295, function(btn)
	spamEnabled = true
	btn.Text = "✅ ספאם מסך פעיל"
	btn.BackgroundColor3 = Color3.fromRGB(225, 245, 225)
end)

createButton("🔴 כבה ספאם מסך", 335, function()
	spamEnabled = false
	isSpamming = false
	spamBtn.Text = "⚡ הפעל ספאם מסך"
	spamBtn.BackgroundColor3 = Color3.fromRGB(250, 250, 250)
end)
