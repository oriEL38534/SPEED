local function toggleMenu()
	frame.Visible = not frame.Visible
end

closeBtn.MouseButton1Click:Connect(toggleMenu)
toggleBtn.MouseButton1Click:Connect(toggleMenu)

-- פונקציה לעדכון מהירות
local function setSpeed(newSpeed)
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = newSpeed
	end
end

-- פונקציית עזר ליצירת כפתורים כהים
local function createButton(text, positionY, onClick)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.86, 0, 0, 32)
	btn.Position = UDim2.new(0.07, 0, 0, positionY)
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(240, 240, 240)
	btn.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
	btn.BorderSizePixel = 0
	btn.TextSize = 15
	btn.Font = Enum.Font.SourceSansSemibold
	btn.Parent = frame

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 5)
	btnCorner.Parent = btn

	btn.MouseButton1Click:Connect(function()
		onClick(btn)
	end)
	return btn
end

-- כפתורי מהירות
createButton("מהירות 30", 50, function() setSpeed(30) end)
createButton("מהירות 100", 90, function() setSpeed(100) end)
createButton("מהירות 200", 130, function() setSpeed(200) end)
createButton("איפוס מהירות (16)", 170, function() setSpeed(16) end)

-- מנגנון ספאם מקש E מהיר בלחיצה ממושכת
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and spamEnabled then
		isSpamming = true
		task.spawn(function()
			while isSpamming and spamEnabled do
				VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
				task.wait()
				VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
				task.wait()
			end
		end)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isSpamming = false
	end
end)

-- כפתורי ספאם
local spamBtn = createButton("⚡ הפעל ספאם E", 215, function(btn)
	spamEnabled = true
	btn.Text = "✅ ספאם E פעיל"
	btn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
end)

createButton("🔴 כבה ספאם E", 255, function()
	spamEnabled = false
	isSpamming = false
	spamBtn.Text = "⚡ הפעל ספאם E"
	spamBtn.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
end)
