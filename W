local openInfo = TweenInfo.new(1.0, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local fadeInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local closeInfo = TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.In)

task.spawn(function()
	-- 1. כניסת חלונית הפתיחה בנפח מלא
	TweenService:Create(introFrame, openInfo, {Size = UDim2.new(0, 320, 0, 120), BackgroundTransparency = 0.05}):Play()
	TweenService:Create(introStroke, fadeInfo, {Transparency = 0}):Play()
	TweenService:Create(glowShadow, fadeInfo, {ImageTransparency = 0.4}):Play()
	TweenService:Create(introLabel, fadeInfo, {TextTransparency = 0}):Play()
	TweenService:Create(subLabel, fadeInfo, {TextTransparency = 0}):Play()
	TweenService:Create(barBackground, fadeInfo, {BackgroundTransparency = 0.5}):Play()
	TweenService:Create(barFill, fadeInfo, {BackgroundTransparency = 0}):Play()

	-- 2. תהליך טעינה דינמי (4 שלבים רצופים)
	local steps = {
		{time = 1.0, progress = 0.35, text = "LOADING MODULES... 35%"},
		{time = 1.2, progress = 0.70, text = "APPLYING GRAPHICS... 70%"},
		{time = 1.1, progress = 0.95, text = "FINALIZING SETUP... 95%"},
		{time = 0.7, progress = 1.00, text = "WELCOME, " .. player.Name:upper() .. "!"}
	}

	for _, step in ipairs(steps) do
		subLabel.Text = step.text
		TweenService:Create(barFill, TweenInfo.new(step.time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(step.progress, 0, 1, 0)
		}):Play()
		task.wait(step.time)
	end

	task.wait(0.5)

	-- 3. יציאה קטיפתית של הפתיח
	TweenService:Create(introFrame, closeInfo, {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1}):Play()
	TweenService:Create(introStroke, fadeInfo, {Transparency = 1}):Play()
	TweenService:Create(glowShadow, fadeInfo, {ImageTransparency = 1}):Play()
	TweenService:Create(introLabel, fadeInfo, {TextTransparency = 1}):Play()
	TweenService:Create(subLabel, fadeInfo, {TextTransparency = 1}):Play()
	TweenService:Create(barBackground, fadeInfo, {BackgroundTransparency = 1}):Play()
	TweenService:Create(barFill, fadeInfo, {BackgroundTransparency = 1}):Play()

	task.wait(0.6)
	introGui:Destroy()

	-- 4. הצגת תפריט המשחק רק עכשיו! עם אפקט הופעה חלק (Fade In)
	frame.Visible = true
	toggleBtn.Visible = true
	
	TweenService:Create(frame, fadeInfo, {BackgroundTransparency = 0}):Play()
	TweenService:Create(toggleBtn, fadeInfo, {BackgroundTransparency = 0}):Play()
end)

