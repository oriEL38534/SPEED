local function applyKorblox()
	local char = player.Character
	if not char then return end

	-- 1. ניקוי CharacterMesh קודם (עבור R6)
	for _, child in ipairs(char:GetChildren()) do
		if child:IsA("CharacterMesh") and child.BodyPart == Enum.BodyPart.RightLeg then
			child:Destroy()
		end
	end

	-- 2. טיפול ב-R6 (Right Leg קלאסי)
	local rightLeg = char:FindFirstChild("Right Leg")
	if rightLeg then
		rightLeg.Transparency = 0
		local mesh = rightLeg:FindFirstChildOfClass("SpecialMesh") or Instance.new("SpecialMesh", rightLeg)
		mesh.MeshType = Enum.MeshType.FileMesh
		mesh.MeshId = "rbxassetid://90294209"
		mesh.TextureId = "rbxassetid://90284029"
		mesh.Scale = Vector3.new(1, 1, 1)
		return
	end

	-- 3. טיפול ב-R15 (אם הדמות ב-R15)
	local rightUpper = char:FindFirstChild("RightUpperLeg")
	local rightLower = char:FindFirstChild("RightLowerLeg")
	local rightFoot = char:FindFirstChild("RightFoot")

	if rightUpper then rightUpper.Transparency = 1 end
	if rightFoot then rightFoot.Transparency = 1 end
	if rightLower then
		rightLower.Transparency = 0
		local mesh = rightLower:FindFirstChildOfClass("SpecialMesh") or Instance.new("SpecialMesh", rightLower)
		mesh.MeshType = Enum.MeshType.FileMesh
		mesh.MeshId = "rbxassetid://90294209"
		mesh.TextureId = "rbxassetid://90284029"
		mesh.Scale = Vector3.new(1, 1, 1)
	end
end
