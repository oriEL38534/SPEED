-- פונקציות עזר
local function createButton(parent, text, onClick)
    local btn = Instance.new("TextButton", parent)
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.Text = text
    btn.TextColor3 = Color3.new(1,1,1)
    btn.BackgroundColor3 = Color3.fromRGB(35, 30, 48)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    btn.MouseButton1Click:Connect(function() onClick(btn) end)
    return btn
end

-- פיצ'רים
local kpsSpamActive = false
createButton(leftCol, "⚡ E-Spam (Safe)", function(btn)
    kpsSpamActive = not kpsSpamActive
    btn.BackgroundColor3 = kpsSpamActive and Color3.fromRGB(140, 50, 200) or Color3.fromRGB(35, 30, 48)
    if kpsSpamActive then
        task.spawn(function()
            while kpsSpamActive do
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                task.wait(0.15)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                task.wait(0.15)
            end
        end)
    end
end)

