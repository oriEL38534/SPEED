----------------------------------------------------
local function createSlider(titleText, minVal, maxVal, defaultVal, positionY, onValueChange)
	-- כותרת + הצגת מספר נבחר
	local sliderLabel = Instance.new("TextLabel")
	sliderLabel.Size = UDim2.new(0.86, 0, 0, 18)
	sliderLabel.Position = UDim2.new(0.07, 0, 0, positionY)
	sliderLabel.Text = titleText .. ": " .. tostring(defaultVal)
	sliderLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
	sliderLabel.BackgroundTransparency = 1
	sliderLabel.TextSize = 13
	sliderLabel.Font = Enum.Font.SourceSansSemibold
	sliderLabel.TextXAlignment = Enum.TextXAlignment.Left
	sliderLabel.Parent = frame

	-- רקע הפס
	local sliderBG = Instance.new("TextButton") -- משתמשים בTextButton לרגישות ללחיצות
	sliderBG.Text = ""
	sliderBG.AutoButtonColor = false
	sliderBG.Size = UDim2.new(0.86, 0, 0, 12)
	sliderBG.Position = UDim2.new(0.07, 0, 0, positionY + 20)
	sliderBG.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
	sliderBG.BorderSizePixel = 0
	sliderBG.Parent = frame

	local bgCorner = Instance.new("UICorner")
	bgCorner.CornerRadius = UDim.new(1, 0)
	bgCorner.Parent = sliderBG

	-- פס מילוי לפי הערך
	local fill = Instance.new("Frame")
	local startScale = (defaultVal - minVal) / (maxVal - minVal)
	fill.Size = UDim2.new(math.clamp(startScale, 0, 1), 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
	fill.BorderSizePixel = 0
	fill.Parent = sliderBG

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	local isDragging = false

	local function updateValue(input)
		local posX = input.Position.X - sliderBG.AbsolutePosition.X
		local scale = math.clamp(posX / sliderBG.AbsoluteSize.X, 0, 1)
		fill.Size = UDim2.new(scale, 0, 1, 0)
		
		local val = math.floor(minVal + (scale * (maxVal - minVal)))
		sliderLabel.Text = titleText .. ": " .. tostring(val)
		onValueChange(val)
	end

	sliderBG.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = true
			updateValue(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isDragging = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateValue(input)
		end
	end)
end

