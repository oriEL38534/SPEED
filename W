-- פונקציה לעדכון מהירות
local function setSpeed(newSpeed)
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = newSpeed
	end
end

-- פונקציית עזר ליצירת כפתורים
local function createButton(text, positionY, onClick)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.86, 0, 0, 32)
	btn.Position = UDim2.new(0.07, 0, 0, positionY)
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(240, 240, 240)
	btn.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
	btn.BorderSizePixel = 0
	btn.TextSize = 15
	btn.Font = Enum.Font.SourceSansSemibold
	btn.Parent = frame

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 5)
	btnCorner.Parent = btn

	btn.MouseButton1Click:Connect(function()
		onClick(btn)
	end)
	return btn
end

-- כפתורי מהירות
createButton("מהירות 30", 50, function() setSpeed(30) end)
createButton("מהירות 100", 90, function() setSpeed(100) end)
createButton("מהירות 200", 130, function() setSpeed(200) end)
createButton("איפוס מהירות (16)", 170, function() setSpeed(16) end)

-- כפתורי הספאם
local spamBtn = createButton("⚡ הפעל ספאם [R]", 215, function() end)
local stopSpamBtn = createButton("🔴 כבה ספאם", 255, function() end)

-- עצירה מוחלטת
local function stopAllSpam()
	spamActive = false
	currentSessionID = currentSessionID + 1
	spamBtn.Text = "⚡ הפעל ספאם [R]"
	spamBtn.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
end

-- הפעלת ספאם עם השהיה אנושית דינמית
local function startSpam()
	stopAllSpam()
	
	spamActive = true
	currentSessionID = currentSessionID + 1
	local myID = currentSessionID
	
	spamBtn.Text = "✅ ספאם E פעיל [R]"
	spamBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
	
	task.spawn(function()
		while spamActive and currentSessionID == myID do
			pcall(function()
				VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
				task.wait(math.random(35, 50) / 1000) -- השהיה דינמית בלחיצה
				VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
			end)
			task.wait(math.random(110, 140) / 1000) -- קצב אנושי למניעת עקיפת Anti-Cheat BAC
		end
	end)
end

local function toggleSpam()
	if spamActive then
		stopAllSpam()
	else
		startSpam()
	end
end

spamBtn.MouseButton1Click:Connect(toggleSpam)
stopSpamBtn.MouseButton1Click:Connect(stopAllSpam)

-- זיהוי מקש R
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.R then
		toggleSpam()
	end
end)
