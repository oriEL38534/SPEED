-- פונקציות עצירה והפעלה לספאם
local function stopSpam()
	spamActive = false
	currentSessionID = currentSessionID + 1
	spamBtn.Text = "⚡ הפעל ספאם [R]"
	spamBtn.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
end

local function startSpam()
	stopSpam()
	spamActive = true
	currentSessionID = currentSessionID + 1
	local myID = currentSessionID
	
	spamBtn.Text = "✅ ספאם E פעיל [R]"
	spamBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
	
	task.spawn(function()
		while spamActive and currentSessionID == myID do
			pcall(function()
				VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
				task.wait(0.015)
				VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
			end)
			-- קצב מותאם למניעת זיהוי BAC Anti-Cheat
			task.wait(0.045)
		end
	end)
end

local function toggleSpam()
	if spamActive then stopSpam() else startSpam() end
end

spamBtn.MouseButton1Click:Connect(toggleSpam)

-- לוגיקה עבור Infinite Jump
local function disableInfJump()
	infJumpActive = false
	if infJumpConnection then
		infJumpConnection:Disconnect()
		infJumpConnection = nil
	end
	infJumpBtn.Text = "🦘 Infinite Jump: כבוי"
	infJumpBtn.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
end

local function enableInfJump()
	disableInfJump()
	infJumpActive = true
	infJumpBtn.Text = "✅ Infinite Jump: פעיל"
	infJumpBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
	
	infJumpConnection = UserInputService.JumpRequest:Connect(function()
		if infJumpActive then
			local char = player.Character
			if char then
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum then
					hum:ChangeState(Enum.HumanoidStateType.Jumping)
				end
			end
		end
	end)
end

infJumpBtn.MouseButton1Click:Connect(function()
	if infJumpActive then disableInfJump() else enableInfJump() end
end)

-- עצירה מוחלטת של כל הרכיבים
local function killAllScriptFunctions()
	stopSpam()
	disableInfJump()
	setSpeed(16)
end

stopAllBtn.MouseButton1Click:Connect(killAllScriptFunctions)

-- מקש R להפעלת/כיבוי ספאם
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.R then
		toggleSpam()
	end
end)
