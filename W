local infJumpBtn = createButton("🦘 Infinite Jump: כבוי", 170, function() end)

local ACTION_NAME = "InfJumpAction"

local function handleJumpAction(actionName, inputState, inputObject)
	if inputState == Enum.UserInputState.Begin then
		if infJumpActive then
			local char = player.Character
			if char then
				local hum = char:FindFirstChildOfClass("Humanoid")
				if hum then
					hum:ChangeState(Enum.HumanoidStateType.Jumping)
				end
			end
		end
	end
	return Enum.ContextAnimationFrame.Pass
end

local function disableInfJump()
	infJumpActive = false
	ContextActionService:UnbindAction(ACTION_NAME)
	infJumpBtn.Text = "🦘 Infinite Jump: כבוי"
	infJumpBtn.BackgroundColor3 = Color3.fromRGB(38, 38, 38)
end

local function enableInfJump()
	disableInfJump()
	infJumpActive = true
	ContextActionService:BindAction(ACTION_NAME, handleJumpAction, false, Enum.KeyCode.Space)
	infJumpBtn.Text = "✅ Infinite Jump: פעיל"
	infJumpBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 40)
end

infJumpBtn.MouseButton1Click:Connect(function()
	if infJumpActive then disableInfJump() else enableInfJump() end
end)

