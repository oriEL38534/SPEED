-- ניקוי הילות
local function removeHighlights()
	if highlightsFolder then
		highlightsFolder:Destroy()
		highlightsFolder = nil
	end
	if createdLight then
		createdLight:Destroy()
		createdLight = nil
	end
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Highlight") and (obj.Name == "BallSuperGlow" or obj.Name:find("_Glow") or obj.Name:find("_BlackAura")) then
			obj:Destroy()
		end
		if obj:IsA("PointLight") and obj.Name == "BallLight" then
			obj:Destroy()
		end
	end
end

-- איתור הכדור
local function findBall()
	local names = {"Ball", "Football", "SoccerBall", "TPSBall"}
	for _, v in ipairs(Workspace:GetDescendants()) do
		if v:IsA("BasePart") then
			for _, name in ipairs(names) do
				if v.Name:lower():find(name:lower()) then
					return v
				end
			end
		end
	end
	return nil
end

-- יצירת הילות למצב כהה (כדור אש + שחקנים בתכלת)
local function applyDarkHighlights()
	removeHighlights()
	
	highlightsFolder = Instance.new("Folder")
	highlightsFolder.Name = "GlowHighlights"
	highlightsFolder.Parent = Workspace

	local targetBall = findBall()
	if targetBall then
		local ballHighlight = Instance.new("Highlight")
		ballHighlight.Name = "BallSuperGlow"
		ballHighlight.FillColor = Color3.fromRGB(255, 120, 0)
		ballHighlight.FillTransparency = 0.1
		ballHighlight.OutlineColor = Color3.fromRGB(255, 255, 0)
		ballHighlight.OutlineTransparency = 0
		ballHighlight.Parent = highlightsFolder
		ballHighlight.Adornee = targetBall

		local light = Instance.new("PointLight")
		light.Name = "BallLight"
		light.Color = Color3.fromRGB(255, 140, 0)
		light.Range = 35
		light.Brightness = 10
		light.Parent = targetBall
		createdLight = light
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			local plrHighlight = Instance.new("Highlight")
			plrHighlight.Name = plr.Name .. "_Glow"
			plrHighlight.FillColor = Color3.fromRGB(0, 180, 255)
			plrHighlight.FillTransparency = 0.5
			plrHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			plrHighlight.OutlineTransparency = 0
			plrHighlight.Parent = highlightsFolder
			plrHighlight.Adornee = plr.Character
		end
	end
end

-- יצירת הילה שחורה כהה ומודגשת לשחקנים ולכדור
local function applyBlackAura()
	removeHighlights()
	
	highlightsFolder = Instance.new("Folder")
	highlightsFolder.Name = "BlackAuraHighlights"
	highlightsFolder.Parent = Workspace

	-- הילה שחורה קהה לכדור
	local targetBall = findBall()
	if targetBall then
		local ballBlackHighlight = Instance.new("Highlight")
		ballBlackHighlight.Name = "Ball_BlackAura"
		ballBlackHighlight.FillColor = Color3.fromRGB(0, 0, 0)
		ballBlackHighlight.FillTransparency = 0.05 -- שחור כמעט אטום
		ballBlackHighlight.OutlineColor = Color3.fromRGB(0, 0, 0)
		ballBlackHighlight.OutlineTransparency = 0
		ballBlackHighlight.Parent = highlightsFolder
		ballBlackHighlight.Adornee = targetBall
	end

	-- הילה שחורה כהה לכל השחקנים
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			local blackHighlight = Instance.new("Highlight")
			blackHighlight.Name = plr.Name .. "_BlackAura"
			blackHighlight.FillColor = Color3.fromRGB(0, 0, 0)
			blackHighlight.FillTransparency = 0.05 -- שחור כמעט אטום ומודגש מאוד
			blackHighlight.OutlineColor = Color3.fromRGB(0, 0, 0)
			blackHighlight.OutlineTransparency = 0
			blackHighlight.Parent = highlightsFolder
			blackHighlight.Adornee = plr.Character
		end
	end
end

