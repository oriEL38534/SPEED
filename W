local function applyKorblox()
	pcall(function()
		local char = player.Character
		if not char then return end
		local rightLower = char:FindFirstChild("RightLowerLeg")
		local rightFoot = char:FindFirstChild("RightFoot")
		if rightLower then
			local mesh = rightLower:FindFirstChildOfClass("SpecialMesh") or Instance.new("SpecialMesh", rightLower)
			mesh.MeshId = "rbxassetid://90294209"
			mesh.TextureId = "rbxassetid://90284029"
		end
		if rightFoot then rightFoot.Transparency = 1 end
	end)
end

local function applyHeadless()
	pcall(function()
		local char = player.Character
		if not char then return end
		local head = char:FindFirstChild("Head")
		if head then
			head.Transparency = 1
			local face = head:FindFirstChildOfClass("Decal")
			if face then face.Transparency = 1 end
		end
	end)
end

